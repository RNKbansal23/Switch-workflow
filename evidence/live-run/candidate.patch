@@ -0,0 +1,29 @@
+import unittest
+
+from order_total import order_total
+
+
+class OrderTotalTests(unittest.TestCase):
+    def test_discount_and_final_rounding(self):
+        for price, quantity, discount, expected in [
+            ("10.05", 1, "10", "9.05"),
+            ("10.04", 1, "10", "9.04"),
+            ("0.05", 3, "10", "0.14"),
+            ("12.50", 2, "0", "25.00"),
+            ("12.50", 2, "100", "0.00"),
+        ]:
+            with self.subTest(price=price, quantity=quantity, discount=discount):
+                self.assertEqual(order_total(price, quantity, discount), expected)
+
+    def test_invalid_orders(self):
+        for args in [
+            ("-1", 1, "0"), ("1", -1, "0"), ("1", 1.5, "0"),
+            ("1", True, "0"), ("1", 1, "101"), ("1", 1, "-1"),
+            ("NaN", 1, "0"), ("1", 1, "Infinity"),
+        ]:
+            with self.subTest(args=args), self.assertRaises(ValueError):
+                order_total(*args)
+
+
+if __name__ == "__main__":
+    unittest.main()